{
  "name": "video-compare-player",
  "version": "0.1.1",
  "description": "A dependency-free video comparison player for split-screen before/after review.",
  "keywords": [
    "video comparison",
    "video compare",
    "before after",
    "before-and-after",
    "split screen",
    "split view",
    "comparison slider",
    "slider",
    "side by side",
    "video player",
    "web component",
    "custom element",
    "esm",
    "react",
    "vue"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/index.global.min.js",
  "jsdelivr": "./dist/index.global.min.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "build:pages": "node ./scripts/build-pages.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && tsc -p ./tests/fixtures/nodenext/tsconfig.json && node --test ./tests/*.test.mjs",
    "test:browser": "npm run build && node ./tests/browser/launch.mjs",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"scripts/**/*.mjs\" \"tests/**/*.{ts,mjs,html,json}\" \"examples/**/*.html\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"scripts/**/*.mjs\" \"tests/**/*.{ts,mjs,html,json}\" \"examples/**/*.html\" \"*.{json,md}\""
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2"
  },
  "sideEffects": [
    "./dist/style.css"
  ],
  "homepage": "https://renningg.github.io/video-compare-player/",
  "repository": {
    "type": "git",
    "url": "https://github.com/renningg/video-compare-player.git"
  },
  "bugs": {
    "url": "https://github.com/renningg/video-compare-player/issues"
  }
}
